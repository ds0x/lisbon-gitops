<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadDescription</key>
	<string>SOC2 CC6.1/CC6.2 - Disables guest account and automatic login (FDE auto-login). Managed by Fleet GitOps.</string>
	<key>PayloadDisplayName</key>
	<string>SOC2 - Login Window Settings</string>
	<key>PayloadEnabled</key>
	<true/>
	<key>PayloadIdentifier</key>
	<string>com.fleet.soc2.loginwindow</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>C9D8E7F6-A5B4-3C2D-1E0F-9A8B7C6D5E4F</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadRemovalDisallowed</key>
	<true/>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadDescription</key>
			<string>Disables guest account access and automatic login.</string>
			<key>PayloadDisplayName</key>
			<string>Login Window</string>
			<key>PayloadEnabled</key>
			<true/>
			<key>PayloadIdentifier</key>
			<string>com.fleet.soc2.loginwindow.config</string>
			<key>PayloadType</key>
			<string>com.apple.loginwindow</string>
			<key>PayloadUUID</key>
			<string>B2C3D4E5-F6A7-8B9C-0D1E-2F3A4B5C6D7E</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>DisableGuestAccount</key>
			<true/>
			<key>DisableFDEAutoLogin</key>
			<true/>
		</dict>
	</array>
</dict>
</plist>
