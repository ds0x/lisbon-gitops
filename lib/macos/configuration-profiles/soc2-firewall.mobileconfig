<plist version="1.0">
<dict>
	<key>PayloadDescription</key>
	<string>SOC2 CC6.3 - Enforces macOS Firewall with stealth mode enabled. Managed by Fleet GitOps.</string>
	<key>PayloadDisplayName</key>
	<string>SOC2 - Enable Firewall</string>
	<key>PayloadEnabled</key>
	<true/>
	<key>PayloadIdentifier</key>
	<string>com.fleet.soc2.firewall</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
