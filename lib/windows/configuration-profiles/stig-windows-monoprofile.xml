<Replace>
  <!-- WN11-AC-000001 / WN10-AC-000035: Minimum password length 14 characters (IA-5) -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/MinDevicePasswordLength</LocURI>
    </Target>
    <Data>14</Data>
  </Item>
</Replace>
<Replace>
  <!-- WN11-AC-000002: Require alphanumeric password with complexity (IA-5) -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/MinDevicePasswordComplexCharacters</LocURI>
    </Target>
    <Data>3</Data>
  </Item>
</Replace>
<Replace>
  <!-- WN11-AC-000010: Account lockout threshold - 3 invalid attempts (AC-7) -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/MaxDevicePasswordFailedAttempts</LocURI>
    </Target>
    <Data>3</Data>
  </Item>
</Replace>
<Replace>
  <!-- WN11-AC-000005: Session lock after 15 minutes of inactivity (AC-11) -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/MaxInactivityTimeDeviceLock</LocURI>
    </Target>
    <Data>15</Data>
  </Item>
</Replace>
<Replace>
  <!-- WN11-AC-000020: Password history - prevent reuse of last 24 passwords (IA-5) -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/DevicePasswordHistory</LocURI>
    </Target>
    <Data>24</Data>
  </Item>
</Replace>
<Replace>
  <!-- WN11-AC-000025: Maximum password age 60 days (IA-5) -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceLock/DevicePasswordExpiration</LocURI>
    </Target>
    <Data>60</Data>
  </Item>
</Replace>
<Replace>
  <!-- WN11-CC-000068: Send NTLMv2 only; refuse LM and NTLM - STIG-unique (IA-7) -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/LocalPoliciesSecurityOptions/NetworkSecurity_LANManagerAuthenticationLevel</LocURI>
    </Target>
    <Data>5</Data>
  </Item>
</Replace>
<Replace>
  <!-- WN11-CC-000075: Enable Windows Defender Credential Guard (SC-3) - STIG-unique -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/DeviceGuard/LsaCfgFlags</LocURI>
    </Target>
    <Data>1</Data>
  </Item>
</Replace>
<Replace>
  <!-- WN11-CC-000330: Disable WinRM Basic Authentication (IA-3) - STIG-unique -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/RemoteManagement/AllowBasicAuthentication_Service</LocURI>
    </Target>
    <Data>0</Data>
  </Item>
</Replace>
<Replace>
  <!-- WN11-CC-000335: Disable WinRM Basic Authentication on client (IA-3) - STIG-unique -->
  <Item>
    <Meta>
      <Format xmlns="syncml:metinf">int</Format>
    </Meta>
    <Target>
      <LocURI>./Device/Vendor/MSFT/Policy/Config/RemoteManagement/AllowBasicAuthentication_Client</LocURI>
    </Target>
    <Data>0</Data>
  </Item>
</Replace>
